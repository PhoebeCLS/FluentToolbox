<Window x:Class="PDFDual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFDual - 现代 PDF 双语中英对照生成工具" 
        SizeToContent="Height" Width="880" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource BrushWindowBg}"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ToggleBtn" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushToggleInactiveFg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource BrushToggleInactiveBg}" CornerRadius="8" Padding="14,6" SnapsToDevicePixels="True" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PDFDual 智能双语对照" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="PDF 中英文双语对照生成工具 (左右并排 / 上下并排 / 3D Touch 滚轮翻页预览)" 
                                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="跟随系统" Style="{StaticResource ToggleBtn}" IsChecked="True" Checked="Theme_Checked" Tag="system"/>
                        <RadioButton Content="深色" Style="{StaticResource ToggleBtn}" Checked="Theme_Checked" Tag="dark"/>
                        <RadioButton Content="浅色" Style="{StaticResource ToggleBtn}" Checked="Theme_Checked" Tag="light"/>
                    </StackPanel>
                </Grid>

                <!-- Mode Selection Card -->
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="🧩 对照排版模式" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="左右并排（中文左，英文右 - 推荐）" Style="{StaticResource ToggleBtn}" IsChecked="True" Tag="side" Checked="Mode_Checked"/>
                            <RadioButton Content="上下并排（中文上，英文下）" Style="{StaticResource ToggleBtn}" Tag="vertical" Checked="Mode_Checked"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtModeDesc" 
                                   Text="💡 左右并排：横向合并双页宽度，左侧显示中文、右侧显示英文，适合宽屏与双语对照精读。" 
                                   FontSize="12" Foreground="#0078D4" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- File Input Card -->
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="📄 中英文 PDF 文件选择 (支持全屏直接拖拽)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12"/>
                        
                        <!-- Chinese PDF Row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🇨🇳 中文 PDF:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCnPath" Grid.Column="1" Height="32" Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" Padding="8,6" VerticalAlignment="Center" Margin="0,0,8,0" Tag="请选择或拖入中文版 PDF 文件..." Text=""/>
                            <Button Grid.Column="2" Content="浏览中文" Style="{StaticResource FluentButton}" Click="BtnBrowseCn_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnPeekCn" Grid.Column="3" Content="👁️ 预览" Style="{StaticResource SecondaryButton}" Padding="10,6" PreviewMouseLeftButtonDown="BtnPeekCn_Down" PreviewMouseLeftButtonUp="BtnPeek_Up" MouseLeave="BtnPeek_Up"/>
                        </Grid>

                        <!-- English PDF Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🇬🇧 英文 PDF:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtEnPath" Grid.Column="1" Height="32" Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" Padding="8,6" VerticalAlignment="Center" Margin="0,0,8,0" Tag="请选择或拖入英文版 PDF 文件..." Text=""/>
                            <Button Grid.Column="2" Content="浏览英文" Style="{StaticResource SecondaryButton}" Click="BtnBrowseEn_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnPeekEn" Grid.Column="3" Content="👁️ 预览" Style="{StaticResource SecondaryButton}" Padding="10,6" PreviewMouseLeftButtonDown="BtnPeekEn_Down" PreviewMouseLeftButtonUp="BtnPeek_Up" MouseLeave="BtnPeek_Up"/>
                        </Grid>

                        <!-- Quick Drop Area -->
                        <Border Background="{DynamicResource BrushToggleInactiveBg}" CornerRadius="8" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" Padding="12" Cursor="Hand" MouseLeftButtonDown="DropArea_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📥 拖拽支持：直接将 PDF 文件拖入窗口任意位置（智能分析中英文 / 弹窗推荐分配）" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Config Card -->
                <Border Style="{StaticResource FluentCard}">
                    <StackPanel>
                        <TextBlock Text="⚙️ 输出设置" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="保存位置:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOutputDir" Grid.Column="1" Height="32" Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" Padding="8,6" VerticalAlignment="Center" Margin="0,0,8,0" Tag="默认自动保存至中文 PDF 所在目录，并自动命名为 [原文件名_中英.pdf]..." Text=""/>
                            <Button Grid.Column="2" Content="自定义" Style="{StaticResource SecondaryButton}" Click="BtnBrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Card -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,0,0">
                    <StackPanel>
                        <Button x:Name="BtnMerge" Content="⚡ 开始生成中英对照 PDF" Style="{StaticResource FluentButton}" Height="42" FontSize="15" Click="BtnMerge_Click" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="ProgressBar" Height="6" Background="{DynamicResource BrushInputBg}" Foreground="#0078D4" BorderThickness="0" Margin="0,0,0,6" Value="0" Maximum="100"/>
                        <TextBlock x:Name="TxtStatus" Text="就绪 - 请选择中文与英文 PDF 文件" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Grid x:Name="GridActionButtons" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOpenPdf" Content="📄 打开生成的 PDF 文件" Style="{StaticResource FluentButton}" Background="#107C41" Height="36" Margin="0,0,6,0" Click="BtnOpenPdf_Click"/>
                            <Button x:Name="BtnOpenFolder" Grid.Column="1" Content="📁 打开输出文件夹" Style="{StaticResource SecondaryButton}" Height="36" Margin="6,0,0,0" Click="BtnOpenFolder_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fullscreen Drag Overlay (Modern Fluent Glass Style) -->
        <Grid x:Name="DragOverlay" Visibility="Collapsed" Background="{DynamicResource BrushDragOverlayBg}" IsHitTestVisible="False">
            <Border BorderBrush="#0078D4" BorderThickness="2" CornerRadius="16" Margin="24" Background="{DynamicResource BrushDragOverlayInner}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📥" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="释放文件以导入 PDF" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="松开鼠标即可智能分析语言并呈现导入建议" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fluent In-App Language Recommendation Modal Dialog -->
        <Grid x:Name="LanguagePickerModal" Visibility="Collapsed" Background="{DynamicResource BrushModalBackdrop}">
            <Border x:Name="ModalCard" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="14" Width="490" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="📄 导入 PDF 语言确认" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnModalPeek" Content="👁️ 按住 3D Touch 预览 (滚轮翻页)" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="12" PreviewMouseLeftButtonDown="BtnModalPeek_Down" PreviewMouseLeftButtonUp="BtnPeek_Up" MouseLeave="BtnPeek_Up"/>
                    </Grid>

                    <TextBlock x:Name="TxtModalFileName" Text="文件名: sample.pdf" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                    
                    <!-- Smart Suggestion Card -->
                    <Border x:Name="BorderSuggestion" Background="{DynamicResource BrushToggleInactiveBg}" CornerRadius="10" BorderBrush="#0078D4" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtSmartSuggestion" Text="💡 检测到文本为【中文】，建议填入【中文 PDF】，是否采纳？" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="BtnAcceptSuggestion" Content="✨ 采纳建议：设为中文 PDF (推荐)" Style="{StaticResource FluentButton}" Height="38" Click="BtnAcceptSuggestion_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Manual Fallback Buttons -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="🇨🇳 设为中文 PDF" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,6,0" Click="BtnModalSetCn_Click"/>
                        <Button Grid.Column="1" Content="🇬🇧 设为英文 PDF" Style="{StaticResource SecondaryButton}" Height="36" Margin="6,0,0,0" Click="BtnModalSetEn_Click"/>
                    </Grid>
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Height="32" Click="BtnModalCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Apple 3D Touch Peek & Pop PDF Preview Overlay with Wheel Paging -->
        <Grid x:Name="PeekPreviewOverlay" Visibility="Collapsed" Background="#B5000000" IsHitTestVisible="False">
            <Border x:Name="PeekCard" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="16" MaxWidth="580" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Two-column header preventing any text collision -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtPeekTitle" Text="📄 PDF 即时预览 (1/1 页)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="松手关闭 · 滚轮翻页" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border CornerRadius="8" ClipToBounds="True" Background="#10000000" HorizontalAlignment="Center">
                        <Image x:Name="ImgPeekPreview" MaxHeight="580" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

