<Window x:Class="IconCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IconCraft 32x32 - 现代图标批量压缩与转换" 
        SizeToContent="Height" Width="880" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource BrushWindowBg}"
        AllowDrop="True"
        Drop="Window_Drop" DragEnter="Window_DragEnter"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="FluentCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ToggleBtn" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushToggleInactiveFg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource BrushToggleInactiveBg}" CornerRadius="8" Padding="14,6" SnapsToDevicePixels="True" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="IconCraft 32x32" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="SVG 矢量图 &amp; 图片高品质批量转换 (现代 22% Squircle 圆角 / 智能域名精简 / 自动去黑边)" 
                               FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="跟随系统" Style="{StaticResource ToggleBtn}" IsChecked="True" Checked="Theme_Checked" Tag="system"/>
                    <RadioButton Content="深色" Style="{StaticResource ToggleBtn}" Checked="Theme_Checked" Tag="dark"/>
                    <RadioButton Content="浅色" Style="{StaticResource ToggleBtn}" Checked="Theme_Checked" Tag="light"/>
                </StackPanel>
            </Grid>

            <!-- Drop Card -->
            <Border Style="{StaticResource FluentCard}" Cursor="Hand" MouseLeftButtonDown="DropCard_Click">
                <StackPanel HorizontalAlignment="Center" Margin="0,4">
                    <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="拖拽图片、SVG 矢量图或文件夹至此区域" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                    <TextBlock Text="支持 .svg, .png, .jpg, .webp, .ico, .bmp 等格式 | 自动抓取文件夹中全部图片" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="选择文件" Style="{StaticResource FluentButton}" Click="BtnBrowseFiles_Click" Margin="0,0,12,0"/>
                        <Button Content="选择文件夹" Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Config Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="⚙️ 转换规则与格式配置" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10"/>
                    
                    <!-- Format Row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出格式:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="32x32 PNG (推荐)" Style="{StaticResource ToggleBtn}" IsChecked="True" Tag="png" Checked="Format_Checked"/>
                            <RadioButton Content="PNG + ICO 双格式" Style="{StaticResource ToggleBtn}" Tag="both" Checked="Format_Checked"/>
                            <RadioButton Content="仅 ICO 图标" Style="{StaticResource ToggleBtn}" Tag="ico" Checked="Format_Checked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shape Row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图标形状:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="iOS圆角矩形(Squircle 22%)" Style="{StaticResource ToggleBtn}" IsChecked="True" Tag="squircle" Checked="Shape_Checked"/>
                            <RadioButton Content="无切角圆形" Style="{StaticResource ToggleBtn}" Tag="circle" Checked="Shape_Checked"/>
                            <RadioButton Content="方形去黑边" Style="{StaticResource ToggleBtn}" Tag="square" Checked="Shape_Checked"/>
                            <RadioButton Content="原样直转" Style="{StaticResource ToggleBtn}" Tag="raw" Checked="Shape_Checked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shape Description Hint -->
                    <TextBlock x:Name="TxtShapeDesc" 
                               Text="💡 iOS/macOS 规范 22% 圆角矩形：完美兼顾画面不切角与所有图标视觉大小对齐一致 (默认强烈推荐！)" 
                               FontSize="12" Foreground="#0078D4" TextWrapping="Wrap" Margin="80,0,0,8"/>

                    <!-- Output Dir Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="输出目录:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOutputDir" Grid.Column="1" Height="32" Background="{DynamicResource BrushInputBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" Padding="8,6" VerticalAlignment="Center" Margin="0,0,8,0" Tag="默认自动保存至各文件所属目录下的 [32×32] 文件夹中..." Text=""/>
                        <Button Grid.Column="2" Content="自定义" Style="{StaticResource SecondaryButton}" Click="BtnBrowseOutput_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Queue Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtQueueTitle" Text="📋 待处理队列 (0 个文件)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Button Content="清空列表" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,3" Click="BtnClearQueue_Click"/>
                    </Grid>
                    <TextBox x:Name="TxtQueueBox" Height="85" Background="{DynamicResource BrushQueueBoxBg}" Foreground="{DynamicResource BrushQueueBoxFg}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" Padding="8" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Text="等待添加文件..."/>
                </StackPanel>
            </Border>

            <!-- Action Card -->
            <Border Style="{StaticResource FluentCard}" Margin="0,0,0,0">
                <StackPanel>
                    <Button x:Name="BtnConvert" Content="🚀 开始批量转换 (0 个文件)" Style="{StaticResource FluentButton}" Height="42" FontSize="15" Click="BtnConvert_Click" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="ProgressBar" Height="6" Background="{DynamicResource BrushInputBg}" Foreground="#0078D4" BorderThickness="0" Margin="0,0,0,6" Value="0" Maximum="100"/>
                    <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Button x:Name="BtnOpenOutput" Content="📂 打开输出文件夹 (32×32)" Style="{StaticResource FluentButton}" Background="#107C41" Height="36" Visibility="Collapsed" Click="BtnOpenOutput_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>

